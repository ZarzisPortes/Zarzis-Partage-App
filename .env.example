# Copy this file to ".env" and fill in the values.

# --- Google sign-in (from Google Cloud Console, see README) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- The ONE address staff will type in their browser ---
# Must be https:// (Google refuses plain http for anything except localhost)
# and must be EXACTLY what you registered as the redirect URI in Google Cloud
# (minus "/auth/google/callback"). Examples:
#   https://files.zarzisportes.com:3443
#   https://192-168-1-50.sslip.io:3443
#   http://localhost:3000            (testing on the server PC only)
BASE_URL=https://192-168-1-50.sslip.io:3443

# --- Who may sign in (strongly recommended) ---
# Comma-separated Gmail addresses allowed in. If both lists are empty,
# ANY Google account that can reach this server can sign in.
ALLOWED_EMAILS=maria@gmail.com,john@gmail.com
# Optional: allow everyone from a Google Workspace domain, e.g. zarzisportes.com
ALLOWED_DOMAINS=

# --- The Chief of the room ---
# Comma-separated emails of the people who manage roles and file access.
# If left empty, the FIRST person to sign in becomes Chief.
CHIEF_EMAILS=maria@gmail.com

# --- Optional settings ---
# PORT=3443                 (default: taken from BASE_URL, else 3443 / 3000)
# MAX_UPLOAD_MB=200         (largest single file)
# TRASH_DAYS=30             (replaced/deleted files are kept this long, 0 = forever)
# DATA_DIR=./data           (where files, database and certificates live)
# SSL_KEY_FILE=             (your own certificate; otherwise one is generated)
# SSL_CERT_FILE=
