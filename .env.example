# Copy this file to ".env" and fill in the values.

# --- Google sign-in (from Google Cloud Console, see README) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- The ONE address staff will type in their browser ---
BASE_URL=https://192-168-1-50.sslip.io:3443

# --- Staff password protection after Google login ---
# If left blank or omitted, any Google login proceeds directly to the room.
STAFF_PASSWORD=

# --- Who may sign in (optional) ---
ALLOWED_EMAILS=
ALLOWED_DOMAINS=

# --- The Chief of the room ---
CHIEF_EMAILS=
